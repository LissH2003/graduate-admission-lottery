# ============================================
# 环境变量配置模板
# 复制此文件为 .env.local 进行本地开发配置
# ============================================

# Supabase 配置（必须）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 认证模式: mock | sso
# - mock: 本地测试模式，使用测试账号登录
# - sso: 统一身份认证模式，跳转竹云登录
VITE_AUTH_MODE=mock

# SSO 配置（仅在 VITE_AUTH_MODE=sso 时生效）
VITE_SSO_AUTH_URL=https://sso.ustb.edu.cn/idp/authCenter/authenticate
VITE_SSO_CLIENT_ID=your-client-id
VITE_SSO_CALLBACK_URL=http://DEPLOY_IP/auth/callback

# Edge Function URL
# 开发环境: http://localhost:54321/functions/v1
# 生产环境: https://your-project.supabase.co/functions/v1
VITE_EDGE_FUNCTION_URL=http://localhost:54321/functions/v1
